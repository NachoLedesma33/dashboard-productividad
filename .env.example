# ===== Frontend (Vite). Exposed to the browser — public, safe. =====
# Paste your VAPID PUBLIC key here (base64url, starts with "B").
# -> https://web-push-codes.glitch.me/ or `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=

# Base URL of the backend API. Leave empty on Vercel (same origin).
# Only set if your frontend and api/ run on different hosts.
VITE_API_BASE=

# ===== Backend (Vercel Functions). Server-only. =====
# VAPID keys (same pair as above)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# QStash (https://console.upstash.com/qstash) — for scheduled pushes
# QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Additional QStash signing keys (optional, used to verify webhooks)
# QSTASH_SIGNING_KEY=

# Public URL of the app. Auto-detected on Vercel; set for local testing.
# APP_URL=https://tu-app.vercel.app
